# === Trajets ===
MORNING_ORIGIN="Montréal, QC"
MORNING_DESTINATION="Québec City, QC"
# Si non définis, EVENING est l'inverse du matin
EVENING_ORIGIN="Québec City, QC"
EVENING_DESTINATION="Toronto, ON"

# === Fuseau horaire ===
TIMEZONE=America/Toronto

# === Plage horaire (heure locale) ===
ACTIVE_HOURS_MORNING_START=5
ACTIVE_HOURS_MORNING_END=10
ACTIVE_HOURS_EVENING_START=15
ACTIVE_HOURS_EVENING_END=20

# === Polling ===
POLL_INTERVAL_MINUTES=10

# === Seuils de notification (minutes) ===
THRESHOLD_MORNING_MINUTES=90
THRESHOLD_EVENING_MINUTES=90

# === Ntfy ===
NTFY_TOPIC=your-secret-topic-here

# === Clés API ===
GOOGLE_API_KEY=your_key_here
MAPBOX_TOKEN=your_token_here
HERE_API_KEY=your_key_here
ORS_API_KEY=your_key_here
